# Frontend API base URL.
# Include /api if your backend routes are mounted there. The app also adds /api
# automatically if it is missing.
EXPO_PUBLIC_API_URL=https://your-new-backend.example.com/api

# Compatibility alias used by older builds/scripts.
EXPO_PUBLIC_BASE_URL=https://your-new-backend.example.com/api

# Optional legacy alias. Prefer EXPO_PUBLIC_API_URL for Expo client code.
API_BASE_URL=https://your-new-backend.example.com/api

# Supabase public config. Use the anon key, never the service role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

EXPO_PUBLIC_ENVIRONMENT=development
EXPO_PUBLIC_DEBUG_MODE=true

# Android package identifier for Expo / EAS builds.
ANDROID_PACKAGE=com.linawletra.app
