# Normalize line endings for all text files to LF, regardless of the
# committer's platform or local core.autocrlf setting. This prevents
# CRLF/LF-only diffs from showing up as spurious "modified" files.
* text=auto eol=lf

# Windows-native scripts are conventionally CRLF; keep them that way so they
# behave correctly when double-clicked or run from cmd.exe.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Explicit binary types (skip text normalization entirely).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.keystore binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
