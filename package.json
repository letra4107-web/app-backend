{
  "name": "linawlm",
  "version": "1.0.0",
  "type": "commonjs",
  "main": "index.ts",
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  },
  "scripts": {
    "start": "npx expo start --clear",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "web": "npx expo start --web",
    "android:verify-env": "node scripts/android-verify-env.js",
    "android:bundle": "node -e \"require('fs').mkdirSync('android/app/src/main/assets', { recursive: true }); require('fs').mkdirSync('android/app/src/main/res', { recursive: true });\" && npx react-native bundle --platform android --dev false --entry-file index.ts --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res/",
    "android:release": "npm run android:verify-env && npx expo prebuild --no-install --clean --platform android && cd android && .\\gradlew.bat clean assembleRelease --no-daemon --stacktrace",
    "eas:build:android": "eas build --platform android --profile production"
  },
  "dependencies": {
    "@expo-google-fonts/baloo-2": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/stack": "^7.8.9",
    "@supabase/supabase-js": "^2.102.0",
    "expo": "~54.0.34",
    "expo-av": "^16.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-secure-store": "~15.0.8",
    "expo-speech": "~14.0.8",
    "expo-speech-recognition": "sdk-54",
    "expo-status-bar": "~3.0.9",
    "fast-levenshtein": "^3.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.1.3",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "expo-build-properties": "^0.14.8",
    "typescript": "~5.9.2"
  },
  "private": true
}
